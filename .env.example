# Node Environment
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_queue?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super-secret-production-key-change-in-production-2026!
JWT_EXPIRES_IN=7d

# Business Configuration
RESERVATION_HOLD_MINUTES=10
APPOINTMENT_REMINDER_HOURS_BEFORE=24
WAITLIST_OFFER_EXPIRY_MINUTES=30
